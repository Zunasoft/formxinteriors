# Instagram API with Instagram Login (business/creator account)
# Only the access token is used at runtime; app id/secret are kept for token exchange/refresh.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

# Zoho CRM (website leads → Leads module). Self Client from api-console.zoho.in,
# scope ZohoCRM.modules.leads.CREATE,ZohoCRM.settings.tags.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in
